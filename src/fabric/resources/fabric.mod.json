{
  "schemaVersion": 1,
  "id": "better_selective_combat",
  "version": "${version}",
  "name": "Better Selective Combat",
  "description": "Pick which weapons should ignore Better Combat on the client and server side.",
  "authors": [
    "wechirok"
  ],
  "license": "GPL-3.0-only",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.wechirok.betterselectivecombat.fabric.BetterSelectiveCombatFabric"
    ],
    "client": [
      "dev.wechirok.betterselectivecombat.fabric.BetterSelectiveCombatFabricClient"
    ]
  },
  "mixins": [
    "better_selective_combat.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "${minecraft_range}",
    "fabric-api": "*",
    "bettercombat": "${better_combat_range}"
  },
